# Copy to server/.env. Never commit secrets.
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ai_intake_outreach

# Optional: Groq API key from https://console.groq.com/ . Without it, the app uses a clearly labelled local rules-based fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SMART Health IT public synthetic FHIR R4 sandbox
FHIR_BASE_URL=https://r4.smarthealthit.org
FHIR_PATIENT_LIMIT=20
FHIR_TIMEOUT_MS=12000

# Local mock CMS endpoint is hosted by this same Express server
CMS_BASE_URL=http://localhost:8080/api/cms/records
LLM_TIMEOUT_MS=20000
